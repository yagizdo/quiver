{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-compact-handover.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${extensionPath}/hooks/scripts/pre-compact-handover.sh",
            "name": "Quiver Handover Auto-Save",
            "timeout": 180000,
            "description": "Saves an 8-section handover note before history compression"
          }
        ]
      }
    ]
  }
}
